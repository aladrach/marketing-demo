---
import ContentLayout from '../layouts/ContentLayout.astro';
import pages from '../data/pages.json';
import {pageData} from '../lib/page-data';
import Icon from '../components/Icon.astro';
import AttackDemo from '../components/AttackDemo.astro';
import CTA from '../components/CTA.astro';
import Prose from '../components/Prose.astro';
import Related from '../components/Related.astro';
import {Image} from 'astro:assets';
import gate from '../assets/connected-system.png';
import CapabilityCards from '../components/CapabilityCards.astro';
const page=pages.find(p=>p.slug==='platform')!;
const {data,integration}=pageData(page);
const t=page.template;
---
<ContentLayout page={page} data={data} integration={integration}>
{t==='platform'&&<>
<section class="page-split wrap"><div class="page-hero"><span class="eyebrow">THE TRACEGATE PLATFORM</span><h1>{page.headline}</h1><p>{page.summary}</p><div class="actions"><a class="button" href="#explorer">Try the path explorer<Icon name="arrow-down" size={16}/></a><a class="text-link" href="/pricing/">Compare plans<Icon name="arrow-right" size={16}/></a></div></div><div class="hero-art"><Image src={gate} alt="An orange signal path meets two architectural gates, a metaphor for connected security." width={800} format="webp" loading="eager"/></div></section>
<section class="wrap" id="explorer"><div class="section-header"><h2>Follow the relationship.<br/>Review the intervention.</h2><p>Explore a synthetic environment. Switch between paths to see how the evidence and proposed next step change.</p></div><AttackDemo/></section>
<section class="section wrap"><div class="section-header"><h2>Three ways to understand the same environment.</h2></div><CapabilityCards/></section>
{page.sections&&<Prose sections={page.sections}/>}<Related slugs={['integrations','solutions/cloud-security','resources/attack-path-review']}/><CTA/>
</>}
</ContentLayout>
