---
import '../styles/components/journal.css';
import '../styles/components/home.css';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AttackDemo from '../components/AttackDemo.astro';
import CapabilityCards from '../components/CapabilityCards.astro';
import Workflow from '../components/Workflow.astro';
import SignalLab from '../components/SignalLab.astro';
import TeamSwitcher from '../components/TeamSwitcher.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import HeroGraph from '../components/HeroGraph.astro';
import IntegrationBlade from '../components/IntegrationBlade.astro';
import home from '../data/home.json';
import guides from '../data/guides.json';
import articles from '../data/articles.json';
---
<Layout title={home.title} description={home.description}>
<section class="hero-stage"><div class="hero-campaign wrap"><div class="hero-copy"><span class="eyebrow">CLOUD + IDENTITY. CONNECTED.</span><h1>See the <span class="hero-keyword">path.</span><br/>Stop the breach.</h1><p>{home.summary}</p><div class="actions"><a class="button" href="/contact/">Book a walkthrough<Icon name="arrow-up-right" size={19}/></a><a class="hero-tour" href="#path-explorer"><span class="play-symbol"><Icon name="player-play" size={14}/></span>Take the interactive tour</a></div></div><HeroGraph/></div><div class="hero-capabilities wrap"><a href="/products/attack-paths/">Follow the exposure<Icon name="arrow-up-right" size={15}/></a><a href="/products/identity-security/">Understand the identity<Icon name="arrow-up-right" size={15}/></a><a href="/products/cloud-posture/">Put posture in context<Icon name="arrow-up-right" size={15}/></a></div></section>
<IntegrationBlade/>
<SignalLab/>
<section class="graph-section" id="path-explorer"><div class="wrap"><div class="graph-section-heading reveal"><div><h2>See what your<br/>backlog can’t show.</h2><p>Switch the scenario. Inspect an identity or asset. Find the relationship that changes the decision.</p></div><a class="text-link" href="/platform/">Meet the platform<Icon name="arrow-up-right" size={17}/></a></div><div class="reveal"><AttackDemo/></div></div></section>
<Workflow/>
<section class="platform-campaign"><div class="wrap section"><div class="section-header reveal"><h2>Three perspectives.<br/><span>One connected platform.</span></h2><p>Keep the findings. Add the context that makes them useful.</p></div><CapabilityCards/></div></section>
<TeamSwitcher/>
<section class="signal-manifesto wrap reveal"><div class="manifesto-mark" aria-hidden="true"><img src="/brand/tracegate-mark.svg" alt="" width="120" height="120"/></div><h2>Security is a team sport.<br/>Give everyone the <span>whole picture.</span></h2><div class="manifesto-copy"><p>Connected cloud security brings configuration findings, identity permissions, and resource relationships into one view. It helps teams investigate how exposures could combine into a path to critical assets.</p><p>Tracegate’s concept keeps the evidence, owner, and proposed intervention together. A potential path is a question to review, not proof of a breach. Human judgment stays in the loop.</p><a class="text-link" href="/about/">The thinking behind Tracegate<Icon name="arrow-up-right" size={16}/></a></div></section>
<section class="journal-section section wrap"><div class="journal-heading reveal"><div><span class="eyebrow">FROM THE WORKBENCH</span><h2>Stay curious.<br/>Get the context.</h2></div><a class="button secondary" href="/resources/">Explore all resources<Icon name="arrow-up-right" size={16}/></a></div><div class="resource-grid"><Card title={guides[0].title} summary={guides[0].summary} category={guides[0].category} href={`/resources/${guides[0].slug}/`} index={0}/><Card title={articles[1].title} summary={articles[1].summary} category={articles[1].category} href={`/blog/${articles[1].slug}/`} index={1}/><Card title={articles[2].title} summary={articles[2].summary} category={articles[2].category} href={`/blog/${articles[2].slug}/`} index={2}/></div></section>
<section class="home-answers wrap"><h2>A clear account<br/>of the concept.</h2><div>{home.faq.map(([q,a])=><details><summary>{q}<Icon name="plus" size={17}/></summary><p>{a}</p></details>)}</div></section><CTA title="See your next move." description="A connected picture. A clearer decision. Explore the Tracegate platform concept."/>
</Layout>
