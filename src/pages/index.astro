---
import '../styles/components/journal.css';
import '../styles/components/home.css';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AttackDemo from '../components/AttackDemo.astro';
import CapabilityCards from '../components/CapabilityCards.astro';
import TeamSwitcher from '../components/TeamSwitcher.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import HeroGraph from '../components/HeroGraph.astro';
import IntegrationBlade from '../components/IntegrationBlade.astro';
import home from '../data/home.json';
import guides from '../data/guides.json';
import articles from '../data/articles.json';
---
<Layout title={home.title} description={home.description}>
<section class="hero-stage"><div class="hero-campaign wrap"><div class="hero-copy"><span class="eyebrow">{home.eyebrow}</span><h1>See how the findings <span class="hero-keyword">connect.</span></h1><p>{home.summary}</p><div class="actions"><a class="button" href="/platform/#explorer">Open the sample explorer<Icon name="arrow-up-right" size={19}/></a><a class="hero-tour" href="#path-explorer"><span class="play-symbol"><Icon name="player-play" size={14}/></span>Explore this page's scenario</a></div><p class="form-note">Portfolio demonstration. No cloud account is connected and no infrastructure is changed.</p></div><HeroGraph/></div><div class="hero-capabilities wrap"><a href="/products/attack-paths/">Follow the exposure<Icon name="arrow-up-right" size={15}/></a><a href="/products/identity-security/">Understand the identity<Icon name="arrow-up-right" size={15}/></a><a href="/products/cloud-posture/">Put posture in context<Icon name="arrow-up-right" size={15}/></a></div></section>
<IntegrationBlade/>
<section class="graph-section" id="path-explorer"><div class="wrap"><div class="graph-section-heading reveal"><div><h2>Review how<br/>findings could connect.</h2><p>Switch the synthetic scenario. Inspect an identity or asset. Review a possible relationship and the assumptions behind it.</p></div><a class="text-link" href="/platform/">Meet the platform<Icon name="arrow-up-right" size={17}/></a></div><div class="reveal"><AttackDemo/></div></div></section>
<TeamSwitcher/>
<section class="platform-campaign"><div class="wrap section"><div class="section-header reveal"><h2>Three perspectives.<br/><span>One connected platform.</span></h2><p>Keep the findings. Add the context that makes them useful.</p></div><CapabilityCards/></div></section>
<section class="journal-section section wrap"><div class="journal-heading reveal"><div><span class="eyebrow">FROM THE WORKBENCH</span><h2>Stay curious.<br/>Get the context.</h2></div><a class="button secondary" href="/resources/">Explore all resources<Icon name="arrow-up-right" size={16}/></a></div><div class="resource-grid"><Card title={guides[0].title} summary={guides[0].summary} category={guides[0].category} href={`/resources/${guides[0].slug}/`} index={0}/><Card title={articles[1].title} summary={articles[1].summary} category={articles[1].category} href={`/blog/${articles[1].slug}/`} index={1}/><Card title={articles[2].title} summary={articles[2].summary} category={articles[2].category} href={`/blog/${articles[2].slug}/`} index={2}/></div></section>
<section class="home-answers wrap"><h2>A clear account<br/>of the concept.</h2><div>{home.faq.map(([q,a])=><details><summary>{q}<Icon name="plus" size={17}/></summary><p>{a}</p></details>)}</div></section><CTA/>
</Layout>
