---
import ContentLayout from '../../layouts/ContentLayout.astro';
import pages from '../../data/pages.json';
import {pageData} from '../../lib/page-data';
import IntegrationDetail from '../../components/IntegrationDetail.astro';
export function getStaticPaths(){return pages.filter(p=>p.template==='integration').map(page=>({params:{slug:page.slug.split('/').at(-1)},props:pageData(page)}));}
const {page,data,integration}=Astro.props;
const t=page.template;
---
<ContentLayout page={page} data={data} integration={integration}>
{t==='integration'&&integration&&<IntegrationDetail integration={integration}/>}
</ContentLayout>
