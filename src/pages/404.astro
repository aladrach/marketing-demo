---
import '../styles/components/notFound.css';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page Not Found | Tracegate Portfolio" description="This path does not lead to a Tracegate page. Return to the homepage or explore the fictional cloud and identity security platform." noindex><section class="not-found wrap"><span class="eyebrow">404 · PATH NOT FOUND</span><h1>This path ends here.<br/>Let’s find another.</h1><p>The page may have moved, or the address may be incomplete. The homepage and resource library are good places to begin.</p><div class="actions"><a class="button" href="/">Return home<Icon name="arrow-right" size={16}/></a><a class="button secondary" href="/resources/">Explore resources<Icon name="arrow-up-right" size={16}/></a></div></section></Layout>
