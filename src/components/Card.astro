---
import Icon from './Icon.astro';
interface Props {title:string;summary:string;href:string;category?:string;index?:number;gated?:boolean;}
const {title,summary,href,category='Perspective',index=0,gated=false}=Astro.props;
---
<article class="resource-card reveal" data-category={category.toLowerCase()} data-search={`${title} ${summary} ${category}`.toLowerCase()}><a href={href}><div class:list={['resource-art','editorial-art',`editorial-art-${index%3}`]} aria-hidden="true"><span class="art-kicker">TRACEGATE / FIELD NOTES</span>{index%3===0?<div class="editorial-network"><svg viewBox="0 0 320 160"><path d="M30 110 150 40 290 110 M30 110 100 140 150 40 220 145 290 110"/><path class="signal" d="M30 110 150 40 290 110"/></svg><span><Icon name="cloud" size={24}/></span><span><Icon name="key" size={27}/></span><span><Icon name="database" size={24}/></span></div>:index%3===1?<div class="editorial-identity"><div class="identity-ring"></div><div class="identity-ring second"></div><span class="identity-core"><Icon name="fingerprint" size={45}/></span><span class="satellite sat-one"><Icon name="cpu" size={20}/></span><span class="satellite sat-two"><Icon name="key" size={20}/></span></div>:<div class="editorial-posture">{['check','check','eye','check','route','check'].map(name=><span><Icon name={name} size={24}/></span>)}</div>}<span class="art-bottom">{index%3===0?'FOLLOW THE CONNECTION':index%3===1?'UNDERSTAND THE ACCESS':'SEE THE CONTEXT'}</span></div><div class="resource-card-body"><span class="meta resource-card-meta">{category}{gated&&<span class="resource-gated-label"><Icon name="lock" size={11}/> DEMO ACCESS</span>}</span><h3>{title}</h3><p>{summary}</p><span class="text-link">{gated?'Get the data sheet':'Read the resource'}<Icon name="arrow-up-right" size={16}/></span></div></a></article>
