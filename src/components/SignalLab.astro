import Icon from './Icon.astro';
---
<section class="signal-lab section wrap reveal" data-signal-lab><div class="signal-lab-heading"><span class="eyebrow">BUILD THE PICTURE</span><h2>What changes<br/>when you connect it?</h2><p>A finding tells you what exists. A relationship tells you what it could mean. Add or remove context to explore the difference.</p><span class="meta">INTERACTIVE MODEL · SYNTHETIC DATA</span></div><div class="signal-lab-console"><div class="lab-controls" role="group" aria-label="Include security context"><button data-evidence="exposure" aria-pressed="true"><span class="lab-switch"></span>Cloud exposure</button><button data-evidence="identity" aria-pressed="true"><span class="lab-switch"></span>Identity access</button><button data-evidence="target" aria-pressed="true"><span class="lab-switch"></span>Asset context</button></div><div class="lab-scene" data-lab-state="connected"><svg viewBox="0 0 600 220" preserveAspectRatio="none" aria-hidden="true"><path class="lab-edge edge-first" d="M95 130 C185 130 190 65 300 65"/><path class="lab-edge edge-second" d="M300 65 C410 65 420 130 505 130"/><circle class="flow-packet" r="5"><animateMotion path="M95 130 C185 130 190 65 300 65 C410 65 420 130 505 130" dur="3s" repeatCount="indefinite"/></circle></svg><div class="lab-entity lab-exposure" data-lab-node="exposure"><Icon name="cloud" size={28}/><strong>Public workload</strong><span>Reachable</span></div><div class="lab-entity lab-identity" data-lab-node="identity"><Icon name="key" size={28}/><strong>Deployment role</strong><span>Broad permission</span></div><div class="lab-entity lab-target" data-lab-node="target"><Icon name="database" size={28}/><strong>Production secrets</strong><span>Sensitive resource</span></div><span class="lab-gap" hidden data-lab-gap>Context missing</span></div><div class="lab-insight" aria-live="polite"><span class="lab-insight-icon"><Icon name="route" size={21}/></span><div><span class="meta" data-lab-count>3 OF 3 CONTEXT LAYERS</span><h3 data-lab-title>A path worth reviewing.</h3><p data-lab-description>The workload can reach an identity with a grant to a sensitive target. Review the relationship, then choose an intervention.</p></div></div><a class="text-link lab-link" href="#path-explorer">Explore the complete path<Icon name="arrow-down" size={16}/></a></div></section>
