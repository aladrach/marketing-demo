---
import Icon from './Icon.astro';
interface Props {variant:string;title:string;caption:string}
const {variant,title,caption}=Astro.props;
---
<figure class:list={['editorial-figure',`editorial-figure-${variant}`]}><div class="editorial-figure-art" role="img" aria-label={caption}><div class="editorial-figure-header"><span class="meta">TRACEGATE / VISUAL FIELD NOTES</span><span class="meta">SYNTHETIC EXAMPLE</span></div><strong class="editorial-figure-title">{title}</strong>
{variant==='path'&&<div class="ef-path"><svg viewBox="0 0 600 170" preserveAspectRatio="none" aria-hidden="true"><path d="M85 110 Q195 110 300 60 T515 110"/><path class="ef-signal" d="M85 110 Q195 110 300 60 T515 110"/></svg>{[['cloud','Exposed workload','ENTRY POINT'],['fingerprint','Effective grant','RELATIONSHIP'],['database','Sensitive resource','TARGET']].map(([icon,label,kind],i)=><div class:list={['ef-node',`ef-node-${i}`]}><Icon name={icon} size={28}/><span>{kind}</span><strong>{label}</strong></div>)}</div>}
{variant==='identity'&&<div class="ef-identity"><span class="ef-orbit"></span><span class="ef-orbit ef-orbit-inner"></span><div class="ef-identity-core"><Icon name="fingerprint" size={43}/><strong>Machine identity</strong></div>{[['cpu','Workload purpose'],['key','Effective access'],['users','Accountable owner'],['refresh','Credential lifecycle']].map(([icon,label],i)=><div class:list={['ef-identity-context',`ef-context-${i}`]}><Icon name={icon} size={19}/><span>{label}</span></div>)}</div>}
{variant==='evidence'&&<div class="ef-evidence">{[['search','Evidence','Source + observation time'],['users','Owner','Accountable team'],['adjustments-horizontal','Scope','Specific relationship'],['check','Verification','Test + refreshed observation']].map(([icon,title,copy],i)=><div><span class="meta">0{i+1}</span><Icon name={icon} size={24}/><strong>{title}</strong><span>{copy}</span></div>)}</div>}
{variant==='comparison'&&<div class="ef-comparison"><section><span class="meta">CONFIGURATION VIEW</span><div class="ef-checks">{['Storage visibility','Policy configuration','Network exposure'].map(item=><span><Icon name="check" size={17}/>{item}</span>)}</div><strong>Does this setting meet expectations?</strong></section><section><span class="meta">CONNECTED VIEW</span><div class="ef-comparison-route"><Icon name="cloud" size={25}/><span></span><Icon name="key" size={25}/><span></span><Icon name="database" size={25}/></div><strong>What could these relationships reach?</strong></section></div>}
</div><figcaption>{caption}</figcaption></figure>
