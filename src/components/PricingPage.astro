---
import Icon from './Icon.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';
import pricing from '../data/pricing.json';
import pages from '../data/pages.json';
const page=pages.find(p=>p.slug==='pricing')!;
---
<section class="page-hero wrap"><h1>{page.headline}</h1><p>{page.summary}</p></section><section class="wrap"><p class="concept-note">Sample pricing for a fictional SaaS company. No plans can be purchased and no charges apply. Prices and entitlements illustrate the marketing experience.</p><div class="pricing-grid">{pricing.map(plan=><article class:list={['price-card','reveal',{featured:plan.featured}]}><span class="meta">{plan.label}</span><h2>{plan.name}</h2><p>{plan.description}</p><div class="price-value">{plan.price}<span>{plan.unit}</span></div><span class="price-caption">{plan.caption}</span><ul>{plan.features.map(f=><li><Icon name="check" size={16}/>{f}</li>)}</ul><a class:list={['button',{secondary:!plan.featured}]} href="/contact/">Explore {plan.name}<Icon name="arrow-up-right" size={16}/></a></article>)}</div><div class="table-scroll" tabindex="0" role="region" aria-label="Plan capability comparison, scroll horizontally"><table class="compare-table"><caption>Compare the intended scope.</caption><thead><tr><th scope="col">Capability</th>{pricing.map(p=><th scope="col">{p.name}</th>)}</tr></thead><tbody>{[['Cloud posture','Included','Included','Included'],['Identity inventory','Included','Included','Included'],['Attack path exploration','Preview','Included','Included'],['Ownership model','Standard','Cross-team','Custom'],['Workflow concepts','Core','Extended','Tailored']].map(([feature,...values])=><tr><th scope="row">{feature}</th>{values.map(v=><td>{v}</td>)}</tr>)}</tbody></table></div></section><FAQ items={[["Are these real prices?","No. They are illustrative prices and entitlements for a fictional portfolio brand. There is no checkout or live service."],["What would determine an enterprise scope?","The concept considers environment complexity, identity relationships, ownership needs, and review workflows. Real scope would require technical evaluation."],["Can I explore the platform without a form?","Yes. The platform overview includes a self-contained interactive path explorer. No email, account, or credential is required."]]}/><CTA/>
