---
import '../styles/components/Header.css';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { Image } from 'astro:assets';
import gate from '../assets/gate.png';
---
<div class="announcement"><span>Connected risk. Clearer decisions.</span><a href="/resources/attack-path-review/">Get the attack path checklist <Icon name="arrow-up-right" size={14}/></a></div>
<header class="site-header">
 <div class="nav-wrap wrap"><Logo/><button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><Icon name="menu-2"/><span>Menu</span></button>
 <nav id="main-nav" aria-label="Main navigation">
 {site.navigation.map(menu=><details class="nav-menu"><summary>{menu.label}<Icon name="chevron-down" size={14}/></summary><div class="mega"><div class="mega-inner"><div class="mega-intro"><span class="eyebrow">{menu.label}</span><h2>A clearer view.<br/>A better next step.</h2><a class="text-link" href={`/${menu.overview}/`}>Explore {menu.label.toLowerCase()}<Icon name="arrow-right" size={16}/></a></div><div class="mega-groups">{menu.groups.map(group=><div><p class="menu-label">{group.label}</p>{group.links.map(([label,href,description])=><a class="mega-link" href={`/${href}/`}><strong>{label}</strong><span>{description}</span></a>)}</div>)}</div><a class="mega-feature" href={`/${menu.featured}/`}><Image src={gate} alt="" width={400} format="webp" loading="lazy"/><span class="menu-label">FEATURED READING</span><strong>{menu.featuredLabel}</strong><span class="text-link">Read the resource<Icon name="arrow-up-right" size={16}/></span></a></div></div></details>)}
 <a class="nav-link" href="/pricing/">Pricing</a><a class="nav-link company-link" href="/about/">Company</a>
 </nav><div class="nav-actions"><button class="motion-toggle" aria-label="Pause decorative motion" aria-pressed="false" title="Pause decorative motion"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="motion-pause-icon" d="M8 5v14M16 5v14"/><path class="motion-play-icon" d="m8 5 11 7-11 7Z"/></svg></button><button class="theme-toggle" aria-label="Switch color theme" title="Switch color theme"><Icon name="sun-moon" size={19}/></button><a class="button small" href="/platform/#explorer">Explore the walkthrough <Icon name="arrow-up-right" size={16}/></a></div>
 </div>
</header>
