---
import Icon from './Icon.astro';
import IntegrationLogo from './IntegrationLogo.astro';
import integrations from '../data/integrations.json';
---
<section class="integration-catalog wrap" data-filter-root data-item-noun="integration"><div class="filter-controls" hidden><div class="filter-buttons" role="group" aria-label="Integration categories">{['All','Cloud','Identity','Workflow'].map((category,i)=><button data-filter={category.toLowerCase()} class:list={['filter-button',{active:i===0}]} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><label class="search-label"><Icon name="search" size={17}/><input type="search" data-search-input aria-label="Search integrations" placeholder="Find an integration"/></label><span class="meta" data-filter-count aria-live="polite">8 integrations</span></div><div class="catalog-grid">{integrations.map(integration=><a class:list={['catalog-card','reveal',`catalog-${integration.slug}`]} href={`/integrations/${integration.slug}/`} data-category={integration.type.toLowerCase()} data-search={`${integration.name} ${integration.description} ${integration.type}`.toLowerCase()}><div class="catalog-card-top"><span class="catalog-logo"><IntegrationLogo slug={integration.slug}/></span><span class="catalog-type">{integration.type}</span></div><h2>{integration.name}</h2><p>{integration.description}</p><span class="text-link">Explore the integration<Icon name="arrow-up-right" size={16}/></span></a>)}</div><p class="filter-empty" data-filter-empty hidden>No matching integrations. Try another name or category.</p><p class="catalog-disclosure">A proposed integration catalog for a fictional platform. These pages describe concepts, not live connectors or partnership claims.</p></section>
