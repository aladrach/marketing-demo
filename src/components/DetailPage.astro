---
import '../styles/components/detailEditorial.css';
import '../styles/components/DetailPage.css';
import Icon from './Icon.astro';
import AttackDemo from './AttackDemo.astro';
import ProductEvidence from './ProductEvidence.astro';
import Workflow from './Workflow.astro';
import CTA from './CTA.astro';
import FAQ from './FAQ.astro';
import Related from './Related.astro';
import {Image} from 'astro:assets';
import connected from '../assets/connected-system.png';
import experience from '../data/experience.json';
interface Props {headline:string;summary:string;kind:string;data:{slug:string;title:string;icon?:string;outcome?:string;steps?:string[];sections:string[][];faq?:string[][];related:string[]}}
const {headline,summary,kind,data}=Astro.props;
const feature=experience.features.find(f=>f.slug===data.slug);
const team=experience.teams.find(t=>t.slug===data.slug);
const sections=data.sections;
---
<section class="detail-campaign wrap"><div class="page-hero"><span class="eyebrow">{data.title}</span><h1>{headline}</h1><p>{summary}</p><div class="actions"><a class="button" href="/platform/#explorer">Explore the walkthrough<Icon name="arrow-up-right" size={16}/></a><a class="text-link" href="#in-context">See it in context<Icon name="arrow-down" size={16}/></a></div></div>{kind==='product'&&data.slug!=='attack-paths'?<ProductEvidence slug={data.slug} compact/>:<div class="detail-art"><Image src={connected} alt="An orange gateway connects cloud, identity, and data objects into one system." width={720} format="webp" loading="eager"/><div class="detail-art-label"><Icon name={data.icon||'route'} size={25}/><div><strong>{feature?.title||team?.focus}</strong><span>Tracegate / {kind==='product'?'Platform capability':'Team workflow'}</span></div></div></div>}</section>
<div class="detail-highlights wrap">{(feature?.bullets||data.steps||[]).map((step,i)=><div><span class="meta">0{i+1}</span><h2>{step}</h2></div>)}</div>
<section class="detail-editorial wrap" id="in-context"><div><span class="eyebrow">{kind==='product'?'CONNECTED BY DESIGN':'BUILT AROUND YOUR WORK'}</span><h2>{feature?.title||team?.title}</h2><p>{feature?.summary||team?.summary}</p><a class="text-link" href="/platform/">Explore the shared platform<Icon name="arrow-up-right" size={16}/></a></div><div><h3>{sections[0][0]}</h3>{sections[0][1].split('\n\n').map(p=><p>{p}</p>)}<h3>{sections[1][0]}</h3>{sections[1][1].split('\n\n').map(p=><p>{p}</p>)}</div></section>
{kind==='product'?<section class="graph-section"><div class="wrap"><div class="graph-section-heading"><div><h2>{data.slug==='identity-security'?'Inspect the identity. Explain its access.':data.slug==='cloud-posture'?'Inspect the finding. Define the next review.':'Follow the path. Review the intervention.'}</h2><p>{data.slug==='identity-security'?'Open a principal to review its grant, owner, and the question that needs an answer.':data.slug==='cloud-posture'?'Open a configuration finding to review ownership, intended behavior, and verification.':'Follow the evidence from an entry point to an identity and a critical resource. All examples are synthetic.'}</p></div></div>{data.slug==='attack-paths'?<AttackDemo/>:<ProductEvidence slug={data.slug}/>}</div></section>:<Workflow id={`workflow-${data.slug}`}/>}
<section class="detail-reading"><div class="wrap"><div class="detail-reading-head"><h2>A closer look.</h2><p>Explore the evidence, workflow, and boundaries.</p></div><div class="detail-accordion">{sections.slice(2).map(([heading,text],i)=><details><summary><span class="meta">0{i+1}</span>{heading}<Icon name="plus" size={20}/></summary>{text.split('\n\n').map(p=><p>{p}</p>)}</details>)}</div></div></section>
{data.faq&&<FAQ items={data.faq}/>}<Related slugs={data.related}/><CTA title={data.outcome||'Move the decision forward.'}/>
