---
import '../styles/components/CTA.css';
import Icon from './Icon.astro';
interface Props {title?:string;description?:string;}
const {title='Review the sample. Consider the next question.',description='Explore the fictional path, inspect its assumptions and review the candidate change. All resources and relationships are synthetic.'}=Astro.props;
---
<section class="cta wrap reveal"><div><h2>{title}</h2><p>{description}</p></div><a class="button" href="/platform/#explorer">Open the sample explorer<Icon name="arrow-up-right" size={18}/></a><span class="cta-mark" aria-hidden="true"><img src="/brand/tracegate-mark.svg" alt="" width="160" height="160"/></span></section>
