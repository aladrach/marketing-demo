---
import '../styles/components/IntegrationLogo.css';
import '../styles/components/IntegrationBlade.css';
import Icon from './Icon.astro';
import BrandLockup from './BrandLockup.astro';
import logos from '../data/integration-logos.json';
---
<section class="integration-blade" aria-label="Integration concepts"><div class="integration-blade-heading wrap"><p>Built around the tools<br/><strong>you already work in.</strong></p><a class="text-link" href="/integrations/">Explore integration concepts<Icon name="arrow-up-right" size={15}/></a></div><div class="logo-marquee" data-logo-marquee><div class="logo-track">{[0,1].map(copy=><div class="logo-group" aria-hidden={copy===1?'true':undefined}>{logos.map(logo=>copy===0?<a class:list={['integration-logo',`integration-logo-${logo.slug}`]} href={`/integrations/${logo.route}/`} aria-label={`Explore ${logo.name} integration concept`}><BrandLockup light={logo.lockup} dark={logo.lockupDark}/><Icon name="arrow-up-right" size={12}/></a>:<span class:list={['integration-logo',`integration-logo-${logo.slug}`]}><BrandLockup light={logo.lockup} dark={logo.lockupDark}/><Icon name="arrow-up-right" size={12}/></span>)}</div>)}</div></div><div class="integration-blade-bottom wrap"><span>Cloud. Identity. Your workflow.</span><button class="logo-playback" data-logo-playback aria-label="Pause integration carousel" aria-pressed="false"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="logo-pause" d="M8 5v14M16 5v14"/><path class="logo-play" d="m8 5 11 7-11 7Z"/></svg><span data-logo-playback-label>Pause</span></button></div></section>
