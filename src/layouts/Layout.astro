---
import '../styles/global.css';
import '../styles/fonts.css';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import displayFont from '@fontsource/ibm-plex-sans-condensed/files/ibm-plex-sans-condensed-latin-600-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import brand from '../data/brand.json';
interface Props {title:string;description:string;kind?:string;article?:{title:string;summary:string;date:string;author:string;coverImage?:string;coverAlt?:string};noindex?:boolean;}
const {title,description,kind='WebPage',article,noindex=false}=Astro.props;
const base=Astro.site || new URL('https://marketing-demo-topaz.vercel.app');
const canonical=new URL(Astro.url.pathname,base).href;
const socialCards={
  home:{path:'/og/tracegate-og-home.png',alt:'Tracegate fictional platform concept: combined context and clearer review of configuration findings, effective access, and potentially reachable paths.',width:1200,height:630,type:'image/png'},
  concept:{path:'/og/tracegate-og-concept.png',alt:'Tracegate fictional platform concept: connected findings to owner review, inspectable evidence, proposed changes, and human approval. Potential paths are not observed breaches.',width:1200,height:630,type:'image/png'},
  resource:{path:'/og/tracegate-og-resource.png',alt:'Tracegate educational resource: The attack path review checklist, covering evidence, assumptions, and owner review. Fictional demo.',width:1200,height:630,type:'image/png'}
} as const;
const sharingOverrides:Record<string,{title:string;description:string}>={
  '/':{title:'Tracegate — Fictional cloud and identity security concept',description:'Explore a fictional platform concept connecting configuration findings, effective access, and potentially reachable paths for review. Potential paths are not observed breaches.'},
  '/platform/':{title:'Tracegate platform — Fictional demo',description:'Explore connected findings, inspectable evidence, proposed changes, and human owner review in a fictional platform demo. Potential paths are not observed breaches.'},
  '/products/':{title:'Tracegate product concepts — Fictional demo',description:'Explore fictional cloud and identity security concepts for connected findings and owner review. Potential paths are not observed breaches.'},
  '/resources/attack-path-review/':{title:'The attack path review checklist | Tracegate',description:'An educational checklist for reviewing evidence, assumptions, and ownership around potentially reachable paths. Tracegate is a fictional demo; a potential path is not an observed breach.'}
};
const pathname=Astro.url.pathname.endsWith('/')?Astro.url.pathname:`${Astro.url.pathname}/`;
const selectedCard=pathname==='/'?socialCards.home:pathname==='/platform/'||pathname==='/products/'?socialCards.concept:pathname==='/resources/attack-path-review/'?socialCards.resource:socialCards.home;
const resolvedImage=article?.coverImage?{
  path:article.coverImage,
  alt:article.coverAlt||selectedCard.alt,
  width:960,
  height:540,
  type:article.coverImage.endsWith('.svg')?'image/svg+xml':article.coverImage.endsWith('.webp')?'image/webp':article.coverImage.endsWith('.jpg')||article.coverImage.endsWith('.jpeg')?'image/jpeg':'image/png'
}:selectedCard;
const socialImage=new URL(resolvedImage.path,base).href;
const sharing=sharingOverrides[pathname];
const sharingTitle=sharing?.title||title;
const sharingDescription=sharing?.description||`${description} Tracegate is a fictional demo; examples are educational and potential paths are not observed breaches.`;
const crumbs=Astro.url.pathname.split('/').filter(Boolean);
const graph:any[]=[{'@type':'Organization','@id':new URL('/#organization',base).href,name:brand.name,url:base.href,description:brand.description,logo:new URL('/brand/tracegate-mark.svg',base).href},{'@type':'WebSite','@id':new URL('/#website',base).href,url:base.href,name:brand.name,description:brand.description,publisher:{'@id':new URL('/#organization',base).href}},{'@type':kind,'@id':canonical+'#page',url:canonical,name:title,description,isPartOf:{'@id':new URL('/#website',base).href}}];
if(crumbs.length)graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:base.href},...crumbs.map((part,i)=>({'@type':'ListItem',position:i+2,name:part.replaceAll('-',' '),item:new URL('/'+crumbs.slice(0,i+1).join('/')+'/',base).href}))]});
if(article)graph.push({'@type':'BlogPosting',headline:article.title,description:article.summary,datePublished:article.date,dateModified:article.date,mainEntityOfPage:canonical,author:{'@type':'Organization',name:article.author,description:'Fictional editorial identity for a portfolio project',url:new URL('/about/',base).href},publisher:{'@id':new URL('/#organization',base).href},image:socialImage});
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="color-scheme" content="light dark"/><meta name="theme-color" content="#F6F7F8"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={sharingTitle}/><meta property="og:description" content={sharingDescription}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Tracegate"/><meta property="og:image" content={socialImage}/><meta property="og:image:type" content={resolvedImage.type}/><meta property="og:image:width" content={String(resolvedImage.width)}/><meta property="og:image:height" content={String(resolvedImage.height)}/><meta property="og:image:alt" content={resolvedImage.alt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={sharingTitle}/><meta name="twitter:description" content={sharingDescription}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content={resolvedImage.alt}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replaceAll('<','\\u003c')}/><script is:inline>document.documentElement.classList.add("js-enabled");try { if(localStorage.getItem("tracegate-motion")==="paused")document.documentElement.dataset.motion="paused"; const theme=localStorage.getItem('tracegate-theme'); if(theme==='light'||theme==='dark')document.documentElement.dataset.theme=theme; }catch{}</script></head><body id="top"><a class="skip-link" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/><script src="../scripts/site.ts"/></body></html>
