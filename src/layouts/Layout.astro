---
import '../styles/global.css';
import '../styles/fonts.css';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import displayFont from '@fontsource/ibm-plex-sans-condensed/files/ibm-plex-sans-condensed-latin-600-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import brand from '../data/brand.json';
interface Props {title:string;description:string;kind?:string;article?:{title:string;summary:string;date:string;author:string};noindex?:boolean;}
const {title,description,kind='WebPage',article,noindex=false}=Astro.props;
const base=Astro.site || new URL('https://tracegate.example');
const canonical=new URL(Astro.url.pathname,base).href;
const crumbs=Astro.url.pathname.split('/').filter(Boolean);
const graph:any[]=[{'@type':'Organization','@id':new URL('/#organization',base).href,name:brand.name,url:base.href,description:brand.description,logo:new URL('/brand/tracegate-mark.svg',base).href},{'@type':'WebSite','@id':new URL('/#website',base).href,url:base.href,name:brand.name,description:brand.description,publisher:{'@id':new URL('/#organization',base).href}},{'@type':kind,'@id':canonical+'#page',url:canonical,name:title,description,isPartOf:{'@id':new URL('/#website',base).href}}];
if(crumbs.length)graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:base.href},...crumbs.map((part,i)=>({'@type':'ListItem',position:i+2,name:part.replaceAll('-',' '),item:new URL('/'+crumbs.slice(0,i+1).join('/')+'/',base).href}))]});
if(article)graph.push({'@type':'BlogPosting',headline:article.title,description:article.summary,datePublished:article.date,dateModified:article.date,mainEntityOfPage:canonical,author:{'@type':'Organization',name:article.author,description:'Fictional editorial identity for a portfolio project',url:new URL('/about/',base).href},publisher:{'@id':new URL('/#organization',base).href},image:new URL('/social-card.png',base).href});
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="color-scheme" content="light dark"/><meta name="theme-color" content="#F6F7F8"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Tracegate"/><meta property="og:image" content={new URL('/social-card.png',base).href}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Tracegate: See the path. Stop the breach. Fictional cybersecurity brand."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL('/social-card.png',base).href}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replaceAll('<','\\u003c')}/><script is:inline>document.documentElement.classList.add("js-enabled");try { if(localStorage.getItem("tracegate-motion")==="paused")document.documentElement.dataset.motion="paused"; const theme=localStorage.getItem('tracegate-theme'); if(theme==='light'||theme==='dark')document.documentElement.dataset.theme=theme; }catch{}</script></head><body id="top"><a class="skip-link" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/><script src="../scripts/site.ts"/></body></html>
