{
  "name": "Tracegate",
  "tagline": "See the path. Stop the breach.",
  "category": "Cloud and identity security",
  "description": "Tracegate is a fictional cloud and identity security platform that connects exposures, permissions, and attack paths so security teams can prioritize the risks that matter.",
  "audience": "Cloud security, identity, and security operations teams at growing SaaS organizations.",
  "promise": "Turn connected risk into a clear next step.",
  "personality": [
    "Clear, never simplistic",
    "Calm, never complacent",
    "Technical, never opaque",
    "Decisive, never alarmist"
  ],
  "colors": [
    {
      "name": "Ink",
      "hex": "#171B20",
      "role": "Primary text and structural contrast"
    },
    {
      "name": "Signal",
      "hex": "#F2693A",
      "role": "Actions, paths, and points of emphasis"
    },
    {
      "name": "Cloud",
      "hex": "#F6F7F8",
      "role": "Primary surface and negative space"
    },
    {
      "name": "Silver",
      "hex": "#DDE1E5",
      "role": "Borders and supporting diagrams"
    },
    {
      "name": "Campaign peach",
      "hex": "#F8E8DC",
      "role": "Warm campaign surface and connected-system artwork"
    }
  ],
  "voice": [
    {
      "principle": "Start with the outcome",
      "do": "Find the permissions that put production data at risk.",
      "avoid": "Unlock next-generation AI-powered security synergy."
    },
    {
      "principle": "Explain the mechanism",
      "do": "Connect identity permissions to exposed cloud resources.",
      "avoid": "Our platform sees everything, everywhere."
    },
    {
      "principle": "Respect the operator",
      "do": "Review the path. Choose the smallest safe change.",
      "avoid": "Sleep soundly. We handle everything."
    },
    {
      "principle": "Earn every claim",
      "do": "A sample environment shows how prioritization works.",
      "avoid": "Trusted by thousands. Guaranteed to stop every breach."
    }
  ],
  "messaging": [
    {
      "pillar": "Connected context",
      "message": "Your cloud and identity risks belong in the same conversation.",
      "proof": "Show the relationship between a principal, its permissions, and the resource it can reach."
    },
    {
      "pillar": "Focused action",
      "message": "Fix the path that matters first.",
      "proof": "Use reachability, business context, and permission scope to explain prioritization."
    },
    {
      "pillar": "Human control",
      "message": "Automate the handoff. Keep the decision.",
      "proof": "Route evidence to an owner and make proposed changes reviewable."
    }
  ],
  "disclosure": "Tracegate is a fictional company created as a design and development portfolio project. Product behavior, organizations, people, and environments shown here are illustrative.",
  "typography": {
    "display": {
      "family": "IBM Plex Sans Condensed",
      "weight": 600,
      "tracking": "-0.03em"
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400,
      "lineHeight": 1.65
    },
    "technical": {
      "family": "IBM Plex Mono",
      "weight": 400
    }
  },
  "designTokens": {
    "base": {
      "--font-body": "'IBM Plex Sans Variable','Helvetica Neue',Arial,sans-serif",
      "--font-display": "'IBM Plex Sans Condensed','Arial Narrow',Arial,sans-serif",
      "--font-mono": "'IBM Plex Mono','Courier New',monospace",
      "--bg": "#f6f7f8",
      "--surface": "#fcfcfd",
      "--subtle": "#edf0f2",
      "--text": "#171b20",
      "--muted": "#59616b",
      "--line": "#d9dde1",
      "--accent": "#f2693a",
      "--accent-ink": "#ae3915",
      "--accent-soft": "#fae9e1",
      "--button": "#171b20",
      "--button-text": "#fafbfc",
      "--radius": "var(--radius-surface)",
      "--shadow": "0 18px 48px #242b3310",
      "--text-xs": "12px",
      "--text-sm": "14px",
      "--text-body": "16px",
      "--text-lg": "18px",
      "--text-title": "25px",
      "--text-section": "clamp(34px,3.5vw,50px)",
      "--text-display": "clamp(44px,5.2vw,76px)",
      "--space-1": "4px",
      "--space-2": "8px",
      "--space-3": "12px",
      "--space-4": "16px",
      "--space-5": "20px",
      "--space-6": "24px",
      "--space-8": "32px",
      "--space-10": "40px",
      "--space-12": "48px",
      "--space-16": "64px",
      "--space-20": "80px",
      "--space-section": "104px",
      "--radius-control": "4px",
      "--radius-surface": "8px",
      "--radius-preview": "12px",
      "--control-min": "44px",
      "--focus-width": "2px",
      "--focus-offset": "5px",
      "--button-hover-bg": "var(--accent)",
      "--button-hover-text": "#171b20",
      "--duration-fast": ".2s",
      "--ease-out": "cubic-bezier(.16,1,.3,1)"
    },
    "dark": {
      "--bg": "#181818",
